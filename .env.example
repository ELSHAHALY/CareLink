# Copy to .env and fill with your Supabase project values
# Dashboard → Settings → API. These are the ONLY required env vars.
# Do NOT use the placeholder values below — the app fails closed in
# production when they are missing/invalid (no mock auth in prod).
VITE_SUPABASE_URL=https://xxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Local Supabase CLI alternative:
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=<anon key from `supabase start`>

# Optional public Gig API base URL for the Contact form.
# The app uses the verified public endpoint as a fallback when this is omitted.
VITE_GIG_API_BASE_URL=https://gig-program-apis-production.up.railway.app
